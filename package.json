{
  "name": "motionbridge",
  "private": true,
  "version": "0.3.0",
  "description": "Open-source browser motion capture for Blender 3D and PNG 2D animation, with GLB/FBX character import and animated GLB, BVH, and JSON export.",
  "author": "adonisglobal (https://github.com/adonisglobal)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adonisglobal/motionbridge.git"
  },
  "homepage": "https://github.com/adonisglobal/motionbridge#readme",
  "bugs": {
    "url": "https://github.com/adonisglobal/motionbridge/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "keywords": [
    "motion-capture",
    "markerless-motion-capture",
    "animation",
    "character-animation",
    "retargeting",
    "3d",
    "blender",
    "bvh",
    "gltf",
    "2d",
    "mediapipe",
    "png",
    "computer-vision",
    "open-source"
  ],
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/check-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test:blender": "node scripts/verify-blender.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/motion/*.test.ts src/video/*.test.ts src/character/*.test.ts src/motion3d/*.test.ts src/export3d/*.test.ts src/character3d/*.test.ts",
    "setup:assets": "node scripts/setup-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
